# Option 1: API token
MOYSKLAD_TOKEN=your_moysklad_token_here

# Option 2: login + password (Basic Auth)
# MOYSKLAD_LOGIN=your_login
# MOYSKLAD_PASSWORD=your_password

MOYSKLAD_BASE_URL=https://api.moysklad.ru/api/remap/1.2
MOYSKLAD_STOCK_MODE=all

# Optional: organization used for customer orders / reserves
# If omitted, the first organization from MoySklad is used.
# MOYSKLAD_ORGANIZATION_ID=

# Optional: external order API base for production hosting
# Local `npm run dev` already exposes /api/orders/reserve via Vite middleware.
# VITE_ORDER_API_URL=https://your-api.example.com

# Admin panel (/admin): required to list/update incoming orders
ADMIN_TOKEN=change-me-admin-token
